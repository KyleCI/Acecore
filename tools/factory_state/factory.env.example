# Fill API_KEY. Fill ADMIN_KEY as well when using --register.
# Blank OTA_URL and API_URL mean https://api-dev.acecore.tech
# (firmware POWERCELL_OTA_BASE_URL_DEFAULT and the WebSocket host).
# Put that same URL in both if you fill them in by hand. An empty value is not sent.
API_KEY=
ADMIN_KEY=
API_URL=
OTA_URL=
# 2.5.40: ESP-NOW smart-socket fleet keys, 96 hex (PMK 32 + LMK 32 + AUTH 32), the same keys the
# AcePlug ESP-NOW firmware is built with. Leave blank to skip (sockets stay off until set).
# Must be set before --lock. Generate fresh keys; never reuse the USB test-pair keys.
ESPNOW_KEYS=
