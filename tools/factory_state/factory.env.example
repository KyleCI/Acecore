# Fill API_KEY. Fill ADMIN_KEY as well when using --register.
# Blank OTA_URL and API_URL mean https://api-dev.acecore.tech
# (firmware POWERCELL_OTA_BASE_URL_DEFAULT and the WebSocket host).
# Put that same URL in both if you fill them in by hand. An empty value is not sent.
API_KEY=
ADMIN_KEY=
API_URL=
OTA_URL=
